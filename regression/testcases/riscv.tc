# RISC-V 32/64 baseline and standard-extension coverage.

=== RISC-V 32 base integer
operation = assemble
triple = riscv32-unknown-elf
split = lines
---
nop
lui a0, 1
auipc a1, 2
addi a0, a1, 1
slti a2, a3, -1
sltiu a4, a5, 7
xori a6, a7, 255
ori t0, t1, 16
andi t2, t3, 31
slli t4, t5, 3
srli t6, t0, 7
srai t1, t2, 11
add a0, a1, a2
sub a3, a4, a5
sll a6, a7, t0
slt t1, t2, t3
sltu t4, t5, t6
xor a0, a1, a2
srl a3, a4, a5
sra a6, a7, t0
or t1, t2, t3
and t4, t5, t6
lb a0, 0(a1)
lh a2, 2(a3)
lw a4, 4(a5)
lbu a6, 7(a7)
lhu t0, 8(t1)
sb t2, 1(t3)
sh t4, 2(t5)
sw t6, 4(a0)
beq a0, a1, 0
bne a2, a3, 0
blt a4, a5, 0
bge a6, a7, 0
bltu t0, t1, 0
bgeu t2, t3, 0
jal ra, 0
jalr zero, 0(ra)
fence
fence.i
ecall
ebreak

=== RISC-V 32 M extension
operation = assemble
triple = riscv32-unknown-elf
features = +m
split = lines
---
mul a0, a1, a2
mulh a3, a4, a5
mulhsu a6, a7, t0
mulhu t1, t2, t3
div t4, t5, t6
divu a0, a1, a2
rem a3, a4, a5
remu a6, a7, t0

=== RISC-V 32 A extension
operation = assemble
triple = riscv32-unknown-elf
features = +a
split = lines
---
lr.w a0, (a1)
sc.w a2, a3, (a4)
amoswap.w a5, a6, (a7)
amoadd.w t0, t1, (t2)
amoxor.w t3, t4, (t5)
amoand.w t6, a0, (a1)
amoor.w a2, a3, (a4)
amomin.w a5, a6, (a7)
amomaxu.w t0, t1, (t2)

=== RISC-V 64 integer
operation = assemble
triple = riscv64-unknown-elf
split = lines
---
nop
addi a0, a1, 1
addiw a2, a3, -1
slli a4, a5, 31
srli a6, a7, 32
srai t0, t1, 47
slliw t2, t3, 3
srliw t4, t5, 7
sraiw t6, a0, 11
add a1, a2, a3
sub a4, a5, a6
addw a7, t0, t1
subw t2, t3, t4
sllw t5, t6, a0
srlw a1, a2, a3
sraw a4, a5, a6
ld a7, 8(t0)
lwu t1, 12(t2)
sd t3, 16(t4)
jalr zero, 0(ra)
ecall

=== RISC-V 64 M/A extensions
operation = assemble
triple = riscv64-unknown-elf
features = +m,+a
split = lines
---
mul a0, a1, a2
mulw a3, a4, a5
div a6, a7, t0
divuw t1, t2, t3
remw t4, t5, t6
lr.d a0, (a1)
sc.d a2, a3, (a4)
amoadd.d a5, a6, (a7)
amoswap.d t0, t1, (t2)

=== RISC-V disassembly RV32
operation = disassemble
triple = riscv32-unknown-elf
split = lines
---
13 00 00 00
37 15 00 00
97 25 00 00
13 85 15 00
93 a6 f6 ff
13 b7 77 00
13 c8 f8 0f
93 62 03 01
93 73 f3 01
13 9e 3e 00

=== RISC-V illegal instructions
operation = assemble
triple = riscv32-unknown-elf
expect = illegal
split = lines
---
not_a_riscv_instruction a0
addi a0, a1, 999999

=== RISC-V canonical printer
operation = disassemble
triple = riscv64-unknown-elf
printer_options = no-aliases
---
13 00 00 00

=== RISC-V numeric register printer
operation = disassemble
triple = riscv64-unknown-elf
printer_options = numeric
---
13 85 c5 02
