# ARMv7 Thumb/Thumb-2 instruction corpus. Each line is one independent test.

=== Thumb integer instructions
operation = assemble
triple = thumbv7-unknown-linux-gnueabihf
split = lines
---
nop
movs r0, #0
movs r1, #1
movs r7, #255
mov r8, r0
mov r0, r8
adds r0, r1, r2
adds r3, #7
adds r4, r5, #3
adcs r0, r1
subs r2, r3, r4
subs r5, #9
sbcs r6, r7
rsbs r0, r1, #0
ands r0, r1
orrs r2, r3
eors r4, r5
bics r6, r7
mvns r0, r1
tst r2, r3
cmp r4, r5
cmp r6, #42
cmn r0, r1
lsls r0, r1, #3
lsrs r2, r3, #7
asrs r4, r5, #11
rors r6, r7
muls r0, r1, r0
ldr r0, [r1]
ldr r2, [r3, #12]
ldrb r4, [r5, #3]
ldrh r6, [r7, #6]
str r0, [r1]
str r2, [r3, #12]
strb r4, [r5, #3]
strh r6, [r7, #6]
ldr r0, [sp, #16]
str r1, [sp, #20]
add r0, sp, #24
add sp, #32
sub sp, #32
push {r4, r5, lr}
pop {r4, r5, pc}
rev r0, r1
rev16 r2, r3
revsh r4, r5
sxth r0, r1
sxtb r2, r3
uxth r4, r5
uxtb r6, r7
cbz r0, #0
cbnz r1, #0
bx lr
blx r3
yield
wfe
wfi
sev

=== Thumb-2 instructions
operation = assemble
triple = thumbv7-unknown-linux-gnueabihf
features = +thumb2
split = lines
---
movw r0, #0x1234
movt r0, #0x5678
add.w r0, r1, r2
sub.w r3, r4, r5
and.w r6, r7, r8
orr.w r9, r10, r11
eor.w r0, r1, r2
bic.w r3, r4, r5
clz r0, r1
rbit r2, r3
ubfx r4, r5, #3, #8
sbfx r6, r7, #4, #7
bfi r0, r1, #8, #8
usat r2, #16, r3
ssat r4, #12, r5
ldr.w r0, [r1, #1024]
str.w r2, [r3, #1024]
ldrb.w r4, [r5, #256]
strb.w r6, [r7, #256]
ldrex r0, [r1]
strex r2, r3, [r4]
dmb sy
dsb sy
isb sy

=== Thumb illegal instructions
operation = assemble
triple = thumbv7-unknown-linux-gnueabihf
expect = illegal
split = lines
---
not_a_thumb_instruction r0
movs r8, #999

=== Thumb disassembly
operation = disassemble
triple = thumbv7-unknown-linux-gnueabihf
split = lines
---
00 bf
00 20
01 21
ff 27
80 46
40 46
88 18
07 33
ec 1c
48 41
1a 1b
09 3d
be 41
48 42
08 40
1a 43
6c 40
be 43
c8 43
70 47

=== Thumb raw register printer
operation = disassemble
triple = thumbv7-unknown-linux-gnueabihf
printer_options = reg-names-raw
---
68 46
