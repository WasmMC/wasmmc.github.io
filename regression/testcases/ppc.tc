# PowerPC 32/64 and endian coverage.

=== PowerPC 32 integer
operation = assemble
triple = powerpc-unknown-linux-gnu
split = lines
---
nop
li 3, 1
lis 4, 0x1234
addi 5, 6, -7
addis 7, 8, 9
add 9, 10, 11
addc 12, 13, 14
adde 15, 16, 17
subf 18, 19, 20
subfc 21, 22, 23
neg 24, 25
and 3, 4, 5
andc 6, 7, 8
or 9, 10, 11
xor 12, 13, 14
nor 15, 16, 17
andi. 18, 19, 255
ori 20, 21, 0x1234
xori 22, 23, 0x5678
slw 24, 25, 26
srw 27, 28, 29
srawi 30, 31, 7
mullw 3, 4, 5
mulhw 6, 7, 8
mulhwu 9, 10, 11
divw 12, 13, 14
divwu 15, 16, 17
cntlzw 18, 19
extsb 20, 21
extsh 22, 23
lwz 3, 0(4)
lwzu 5, 4(6)
lbz 7, 1(8)
lhz 9, 2(10)
lha 11, 4(12)
stw 13, 8(14)
stb 15, 3(16)
sth 17, 6(18)
blr
bctr
sync
isync
sc

=== PowerPC 64 little-endian integer
operation = assemble
triple = powerpc64le-unknown-linux-gnu
cpu = pwr8
split = lines
---
nop
li 3, 1
add 4, 5, 6
subf 7, 8, 9
mulld 10, 11, 12
mulhd 13, 14, 15
mulhdu 16, 17, 18
divd 19, 20, 21
divdu 22, 23, 24
cntlzd 25, 26
extsw 27, 28
sld 3, 4, 5
srd 6, 7, 8
srad 9, 10, 11
rldicl 12, 13, 7, 16
rldicr 14, 15, 11, 47
ld 16, 0(17)
ldu 18, 8(19)
std 20, 16(21)
stdu 22, -16(23)
blr

=== PowerPC 64 big-endian integer
operation = assemble
triple = powerpc64-unknown-linux-gnu
cpu = pwr8
split = lines
---
nop
li 3, 1
add 4, 5, 6
subf 7, 8, 9
mulld 10, 11, 12
divd 13, 14, 15
cntlzd 16, 17
sld 18, 19, 20
ld 21, 0(22)
std 23, 8(24)
blr

=== PowerPC 32 disassembly
operation = disassemble
triple = powerpc-unknown-linux-gnu
split = lines
---
60 00 00 00
38 60 00 01
3c 80 12 34
38 a6 ff f9
3c e8 00 09
7d 2a 5a 14
7d 8d 70 14
7d f0 89 14
7e 53 a0 50
7e b6 b8 10

=== PowerPC illegal instructions
operation = assemble
triple = powerpc-unknown-linux-gnu
expect = illegal
split = lines
---
not_a_powerpc_instruction 3
addi 3, 4, 999999
