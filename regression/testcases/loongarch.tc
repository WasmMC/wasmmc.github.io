=== LoongArch64 illegal disassembly
operation = disassemble
triple = loongarch64-unknown-linux-gnu
cpu = generic-la64
wasm_target = optional
expect = illegal
---
ff ff ff ff

=== LoongArch64 numeric register printer
operation = disassemble
triple = loongarch64-unknown-linux-gnu
cpu = generic-la64
printer_options = numeric
wasm_target = optional
---
a4 b0 c0 02
