# MIPS32/MIPS64, little- and big-endian.

=== MIPS32 little-endian integer
operation = assemble
triple = mipsel-unknown-linux-gnu
cpu = mips32r2
split = lines
---
nop
addiu $2, $zero, 1
addiu $3, $4, -7
addu $5, $6, $7
subu $8, $9, $10
and $11, $12, $13
or $14, $15, $16
xor $17, $18, $19
nor $20, $21, $22
slt $23, $24, $25
sltu $2, $3, $4
slti $5, $6, -3
sltiu $7, $8, 9
andi $9, $10, 255
ori $11, $12, 0x1234
xori $13, $14, 0x5678
lui $15, 0x1234
sll $16, $17, 3
srl $18, $19, 7
sra $20, $21, 11
sllv $22, $23, $24
srlv $25, $2, $3
srav $4, $5, $6
mult $7, $8
multu $9, $10
div $zero, $11, $12
divu $zero, $13, $14
mfhi $15
mflo $16
clz $17, $18
clo $19, $20
lb $2, 0($3)
lbu $4, 1($5)
lh $6, 2($7)
lhu $8, 4($9)
lw $10, 8($11)
sb $12, 3($13)
sh $14, 6($15)
sw $16, 12($17)
jr $ra
jalr $25
break 1
syscall 2

=== MIPS32 big-endian integer
operation = assemble
triple = mips-unknown-linux-gnu
cpu = mips32r2
split = lines
---
nop
addiu $2, $zero, 1
addu $5, $6, $7
subu $8, $9, $10
and $11, $12, $13
or $14, $15, $16
xor $17, $18, $19
slt $23, $24, $25
sll $16, $17, 3
srl $18, $19, 7
lw $10, 8($11)
sw $16, 12($17)
jr $ra

=== MIPS64 little-endian integer
operation = assemble
triple = mips64el-unknown-linux-gnu
cpu = mips64r2
split = lines
---
nop
daddiu $2, $zero, 1
daddu $3, $4, $5
dsubu $6, $7, $8
dsll $9, $10, 3
dsrl $11, $12, 7
dsra $13, $14, 11
dsll32 $15, $16, 3
dsrl32 $17, $18, 7
dsra32 $19, $20, 11
dmult $21, $22
dmultu $23, $24
ddiv $zero, $25, $2
ddivu $zero, $3, $4
ld $5, 8($6)
sd $7, 16($8)
lwu $9, 20($10)
jr $ra

=== MIPS64 big-endian integer
operation = assemble
triple = mips64-unknown-linux-gnu
cpu = mips64r2
split = lines
---
nop
daddiu $2, $zero, 1
daddu $3, $4, $5
dsubu $6, $7, $8
dsll $9, $10, 3
dsrl $11, $12, 7
ld $5, 8($6)
sd $7, 16($8)
jr $ra

=== MIPS32 little-endian disassembly
operation = disassemble
triple = mipsel-unknown-linux-gnu
cpu = mips32r2
split = lines
---
00 00 00 00
01 00 02 24
f9 ff 83 24
21 28 c7 00
23 40 2a 01
24 58 8d 01
25 70 f0 01
26 88 53 02
27 a0 b6 02
2a b8 19 03

=== MIPS32 big-endian disassembly
operation = disassemble
triple = mips-unknown-linux-gnu
cpu = mips32r2
split = lines
---
00 00 00 00
24 02 00 01
00 c7 28 21
01 2a 40 23
01 8d 58 24
01 f0 70 25

=== MIPS illegal instructions
operation = assemble
triple = mipsel-unknown-linux-gnu
expect = illegal
split = lines
---
not_a_mips_instruction $2
addiu $2, $3, 999999
