# Feature-enforcement policy suite. Run explicitly; this directory is not
# included by the default regression discovery path.

=== ARM NEON rejected at baseline
operation = assemble
triple = armv7-unknown-linux-gnueabihf
cpu = generic
expect = illegal
---
vadd.i32 q0, q1, q2

=== ARM NEON enabled
operation = assemble
triple = armv7-unknown-linux-gnueabihf
cpu = generic
features = +neon
---
vadd.i32 q0, q1, q2

=== ARM NEON explicitly disabled
operation = assemble
triple = armv7-unknown-linux-gnueabihf
cpu = generic
features = -neon,-mve
expect = illegal
---
vadd.i32 q0, q1, q2

=== ARM VFP permissive baseline
operation = assemble
triple = armv7-unknown-linux-gnueabihf
cpu = generic
---
vadd.f32 s0, s1, s2

=== AArch64 Crypto rejected at baseline
operation = assemble
triple = aarch64-unknown-linux-gnu
cpu = generic
expect = illegal
---
aesd v0.16b, v1.16b

=== AArch64 Crypto enabled
operation = assemble
triple = aarch64-unknown-linux-gnu
cpu = generic
features = +crypto
---
aesd v0.16b, v1.16b

=== AArch64 LSE rejected at baseline
operation = assemble
triple = aarch64-unknown-linux-gnu
cpu = generic
expect = illegal
---
cas x0, x1, [x2]

=== AArch64 LSE enabled
operation = assemble
triple = aarch64-unknown-linux-gnu
cpu = generic
features = +lse
---
cas x0, x1, [x2]

=== AArch64 SVE rejected at baseline
operation = assemble
triple = aarch64-unknown-linux-gnu
cpu = generic
expect = illegal
---
ptrue p0.b

=== AArch64 SVE enabled
operation = assemble
triple = aarch64-unknown-linux-gnu
cpu = generic
features = +sve
---
ptrue p0.b

=== AArch64 CRC rejected at baseline
operation = assemble
triple = aarch64-unknown-linux-gnu
cpu = generic
expect = illegal
---
crc32b w0, w1, w2

=== AArch64 CRC enabled
operation = assemble
triple = aarch64-unknown-linux-gnu
cpu = generic
features = +crc
---
crc32b w0, w1, w2

=== AArch64 DOTPROD rejected at baseline
operation = assemble
triple = aarch64-unknown-linux-gnu
cpu = generic
expect = illegal
---
sdot v0.4s, v1.16b, v2.16b

=== AArch64 DOTPROD enabled
operation = assemble
triple = aarch64-unknown-linux-gnu
cpu = generic
features = +dotprod
---
sdot v0.4s, v1.16b, v2.16b

=== RISC-V 32 M rejected at baseline
operation = assemble
triple = riscv32-unknown-elf
expect = illegal
---
mul a0, a1, a2

=== RISC-V 32 M enabled
operation = assemble
triple = riscv32-unknown-elf
features = +m
---
mul a0, a1, a2

=== RISC-V 64 M rejected at baseline
operation = assemble
triple = riscv64-unknown-elf
expect = illegal
---
mul a0, a1, a2

=== RISC-V 64 M enabled
operation = assemble
triple = riscv64-unknown-elf
features = +m
---
mul a0, a1, a2

=== RISC-V 64 A rejected at baseline
operation = assemble
triple = riscv64-unknown-elf
expect = illegal
---
amoadd.w a0, a1, (a2)

=== RISC-V 64 A enabled
operation = assemble
triple = riscv64-unknown-elf
features = +a
---
amoadd.w a0, a1, (a2)

=== RISC-V 64 F rejected at baseline
operation = assemble
triple = riscv64-unknown-elf
expect = illegal
---
fadd.s fa0, fa1, fa2

=== RISC-V 64 F enabled
operation = assemble
triple = riscv64-unknown-elf
features = +f
---
fadd.s fa0, fa1, fa2

=== RISC-V 64 C rejected at baseline
operation = assemble
triple = riscv64-unknown-elf
expect = illegal
---
c.addi a0, 1

=== RISC-V 64 C enabled
operation = assemble
triple = riscv64-unknown-elf
features = +c
---
c.addi a0, 1

=== MIPS32 MSA rejected at baseline
operation = assemble
triple = mipsel-unknown-linux-gnu
expect = illegal
---
addvi.b $w0, $w1, 1

=== MIPS32 MSA enabled
operation = assemble
triple = mipsel-unknown-linux-gnu
features = +msa
---
addvi.b $w0, $w1, 1

=== MIPS64 DSP rejected at baseline
operation = assemble
triple = mips64el-unknown-linux-gnu
expect = illegal
---
addu.qb $2, $3, $4

=== MIPS64 DSP enabled
operation = assemble
triple = mips64el-unknown-linux-gnu
features = +dsp
---
addu.qb $2, $3, $4

=== SPARC64 VIS rejected at baseline
operation = assemble
triple = sparcv9-unknown-linux-gnu
expect = illegal
---
pdist %f0, %f2, %f4

=== SPARC64 VIS enabled
operation = assemble
triple = sparcv9-unknown-linux-gnu
features = +vis
---
pdist %f0, %f2, %f4

=== Hexagon HVX rejected at baseline
operation = assemble
triple = hexagon-unknown-linux-musl
cpu = hexagonv60
expect = illegal
---
v0.w = vrmpy(v1.ub,v2.b)

=== Hexagon HVX-v66 enabled
operation = assemble
triple = hexagon-unknown-linux-musl
cpu = hexagonv60
features = +hvxv66
---
v0.w = vrmpy(v1.ub,v2.b)

=== LoongArch64 LSX permissive baseline
operation = assemble
triple = loongarch64-unknown-linux-gnu
cpu = generic-la64
---
vadd.b $vr0, $vr1, $vr2

=== LoongArch64 LASX permissive baseline
operation = assemble
triple = loongarch64-unknown-linux-gnu
cpu = generic-la64
---
xvadd.b $xr0, $xr1, $xr2

# Controls documenting targets where llvm-mc accepts the instruction without
# requiring the nominal extension.

=== x86 AVX-512 permissive baseline
operation = assemble
triple = x86_64-unknown-linux-gnu
cpu = x86-64
intel_syntax = true
---
vaddps zmm0, zmm1, zmm2

=== PPC64 Altivec permissive baseline
operation = assemble
triple = powerpc64le-unknown-linux-gnu
---
vaddubm 2, 3, 4

=== BPF atomic permissive baseline
operation = assemble
triple = bpfel-unknown-none
---
store_release((u32 *)(r1 + 0), w2)

=== Thumb DSP permissive baseline
operation = assemble
triple = thumbv7-unknown-linux-gnueabihf
---
smlad r0, r1, r2, r3
